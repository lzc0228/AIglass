# DashScope API Key（必填：ASR + Qwen-Omni + Qwen Turbo）
# 申请地址：https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=your_api_key_here
# 云端ASR开关：0=关闭（推荐离线/弱网），1=启用DashScope实时识别
# AIGLASS_CLOUD_ASR_ENABLED=0

# ===== 可选：模型路径覆盖（默认都在 ./model 下）=====
# BLIND_PATH_MODEL=model/yolo-seg.pt
# OBSTACLE_MODEL=model/yoloe-11l-seg.pt
# TRAFFIC_LIGHT_MODEL=model/trafficlight.pt
# ITEM_SEARCH_MODEL=model/shoppingbest5.pt
# HAND_LANDMARKER_TASK=model/hand_landmarker.task

# ===== 可选：推理/性能参数 =====
# AIGLASS_DEVICE=cuda:0
# AIGLASS_AMP=bf16
# AIGLASS_GPU_SLOTS=2

# ===== 可选：音频/语音资源目录 =====
# VOICE_DIR=voice
# AIGLASS_AUDIO_DIR=music
# AIGLASS_COMPRESS_AUDIO=1

# ===== 可选：音频输出配置 =====
# AIGLASS_AUDIO_OUTPUT=local    # 输出模式: local(本地)/bluetooth(蓝牙)/esp32
# AIGLASS_ENABLE_LOCAL_AUDIO=0   # 启用本地 pygame 音频播放
# AIGLASS_LOCAL_FALLBACK_PLAYBACK=0  # 是否允许回退到硬件扬声器（默认关闭，避免漏音）
# AIGLASS_FORCE_AUDIO_LOG=1           # 输出强制播报日志（命中路径/输出路径）
# AIGLASS_AUDIO_PRELOAD_MODE=auto     # 音频预加载策略: auto/full/limited/off（Nano推荐limited）
# AIGLASS_AUDIO_PRELOAD_MAX_FILES=120 # limited 模式预加载上限（Nano推荐 80~150）
# AIGLASS_AUDIO_PRELOAD_PROGRESS_EVERY=100  # 预加载进度日志输出间隔
# AIGLASS_SPEECH_SERIALIZE=1          # 非紧急播报串行：当前一句播完后再触发下一轮场景播报
# AIGLASS_SCENE_AFTER_SPEECH_ONLY=1   # 场景播报仅在语音空闲时触发
# AIGLASS_SCENE_POST_SPEECH_GAP_SEC=0.2  # 一句播报结束后额外等待时间（秒）
# AIGLASS_AUDIO_BUSY_SKIP_SEMANTIC=1  # 音频忙时跳过语义重计算（弱算力设备推荐）
# AIGLASS_ASR_PRECHECK=1              # START 前做 ASR 网络预检，网络不可用时直接返回错误
# AIGLASS_ASR_HOST_CHECK=dashscope.aliyuncs.com
# AIGLASS_ASR_PRECHECK_TIMEOUT_SEC=1.5
# AIGLASS_STARTUP_AUDIO_SELFTEST_PLAY=1   # 启动时执行音频自检并可选播放探测语音
# AIGLASS_STARTUP_AUDIO_SELFTEST_TEXT=音频链路自检完成

# ===== 可选：蓝牙音频配置 =====
# AIGLASS_BLUETOOTH_ENABLED=0       # 启用蓝牙音频
# AIGLASS_BLUETOOTH_DEVICE_ADDR=    # 蓝牙设备MAC地址（如：11:22:33:44:55:66）
# AIGLASS_BLUETOOTH_DEVICE_NAME=联想S102  # 蓝牙设备名称（用于自动连接）
# AIGLASS_BLUETOOTH_AUTO_CONNECT=0  # 启动时自动连接
# AIGLASS_AUDIO_AUTO_SWITCH=1      # 自动切换音频输出（蓝牙连接检测）

# ===== 可选：TTS 文字转语音配置 =====
# AIGLASS_TTS_ENABLED=0             # 启用 TTS（用于无预录音频的文本）
# AIGLASS_TTS_ENGINE=piper          # TTS 引擎: piper
# AIGLASS_TTS_MODEL=model/piper/zh_CN-huayan-medium.onnx
# AIGLASS_TTS_VOICE=zh_CN-huayan-medium
# AIGLASS_TEXT_FRAGMENT_FALLBACK=0  # 文本片段拼接回退（默认关，优先整句TTS避免“的的的的”）
# AIGLASS_VOICE_TEXT_COOLDOWN_SEC=0.8
# AIGLASS_AUDIO_METRICS_LOG_INTERVAL_SEC=5.0

# ===== 可选：朋友/人脸识别（本地）=====
# AIGLASS_FACE_DB_DIR=context/faces
# AIGLASS_FACE_MATCH_THRESHOLD=65

# ===== 可选：灯光关闭提醒（启发式阈值）=====
# AIGLASS_LIGHT_SAMPLE_EVERY_N_FRAMES=10
# AIGLASS_LIGHT_BRIGHT_V_THRESH=235
# AIGLASS_LIGHT_BRIGHT_AREA_ON=0.0025
# AIGLASS_LIGHT_BRIGHT_AREA_OFF=0.0015
# AIGLASS_LIGHT_MEAN_LUMA_MAX_FOR_INDOOR=175
# AIGLASS_LIGHT_STABLE_FRAMES=5
# AIGLASS_LIGHT_REMIND_COOLDOWN_SEC=60

# ===== 可选：户外天黑提醒（夜间户外提醒用户开灯让别人知道是盲人）=====
# AIGLASS_NIGHT_LIGHT_REMINDER=1      # 启用户外天黑提醒
# AIGLASS_NIGHT_LIGHT_COOLDOWN=600    # 提醒冷却时间（秒，默认10分钟）

# ===== 可选：自动场景识别（接收到画面后自动运行检测并主动播报）=====
# AIGLASS_AUTO_SCENE_DETECTION=1      # 启用自动场景识别
# AIGLASS_AUTO_DETECTION_INTERVAL=12  # 检测间隔（秒，Nano建议12+）

# ===== 可选：语义输出/场景探索（WP1/WP2/WP3/WP4 最小实现）=====
# AIGLASS_SEM_PERIOD_SEC=10.0         # Nano建议10+，优先稳定播报
# AIGLASS_WEIGHTS_DIR=context/weights
# AIGLASS_USER_PREFS=context/user_prefs.json
# AIGLASS_SEM_MIN_INTERVAL=6.0
# AIGLASS_SEM_IOU_DEDUP=0.6
# AIGLASS_SEM_TURN_DPS=25.0
# AIGLASS_SCENE_STRATEGIES=context/weights/scene_strategies.json
# AIGLASS_SEM_CONF_THRESHOLD=0.2      # compare任务：先过滤 conf>0.2
# AIGLASS_SEM_STAGE1_TOPK=10          # 10 -> 5 -> 3 第一阶段
# AIGLASS_SEM_STAGE2_TOPK=5
# AIGLASS_SEM_OUTPUT_TOPK=3
# AIGLASS_STRUCTURED_NUMBERED=1      # 结构化输出使用“第一、第二”编号样式

# ===== 可选：实时物体播报与语音预设（白名单物体）=====
# AIGLASS_REALTIME_OBJECT_ANNOUNCE=1   # 输入实时帧后自动播报物体
# AIGLASS_REALTIME_OBJECT_PERIOD_SEC=9.0
# AIGLASS_OBJECT_VOICE_PREGEN_MAX=2000 # 启动时最多预生成多少条物体语音

# ===== 可选：viewer 回传降载 =====
# AIGLASS_VIEWER_TARGET_FPS=6
# AIGLASS_VIEWER_JPEG_QUALITY=45
# AIGLASS_VIEWER_MAX_WIDTH=640
# AIGLASS_CAMERA_PROCESS_TARGET_FPS=8   # 视觉主处理链路上限（超过则跳过重计算）
# AIGLASS_VIEWER_PASSTHROUGH_ON_SKIP=1  # 跳帧时直接透传原始JPEG，减少解码/编码负载
# AIGLASS_NAV_DEBUG=0                   # 关闭高频调试日志（Nano建议0）
# AIGLASS_ADAPTIVE_VIEWER_THROTTLE=1     # 音频压力上来时自动再降viewer fps
# AIGLASS_PIPELINE_METRICS_INTERVAL_SEC=5.0

# ===== 可选：事件记录（JSONL，用于回放/评估）=====
# AIGLASS_EVENT_LOG=1
# AIGLASS_EVENT_LOG_PATH=recordings/events.jsonl
